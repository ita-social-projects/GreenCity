<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-inset-employee-authorities" author="Vladyslav Haliara">
        <preConditions>
            <tableExists tableName="employee_authorities"/>
            <tableExists tableName="employee_authorities_mapping"/>
            <columnExists tableName="employee_authorities" columnName="name"/>
        </preConditions>

        <insert tableName="employee_authorities">
            <column name="id" valueComputed="(SELECT COALESCE(MAX(id), 0) + 1 FROM employee_authorities)"/>
            <column name="name" value="TELEGRAM_MANAGEMENT"/>
        </insert>

        <insert tableName="employee_authorities_mapping">
            <column name="authority_id" valueComputed="(SELECT MAX(id) FROM employee_authorities)"/>
            <column name="user_id" value="2"/>
        </insert>
    </changeSet>
</databaseChangeLog>
