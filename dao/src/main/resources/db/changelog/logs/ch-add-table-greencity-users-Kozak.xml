<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="add-greencity-user-table" author="Maksym Kozak">
        <createTable tableName="greencity_users">
            <column name="id" autoIncrement="true" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>
            <column name="email" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="user_status" type="int" />
            <column name="profile_picture" type="VARCHAR(300)" />
            <column name="event_organizer_rating" type="DOUBLE" />
        </createTable>
    </changeSet>
    <changeSet id="fill-greencity-user-table" author="Maksym Kozak">
        <sql>
            INSERT INTO greencity_users
            SELECT id, email, name, user_status, profile_picture, event_organizer_rating FROM users;
        </sql>
    </changeSet>
</databaseChangeLog>