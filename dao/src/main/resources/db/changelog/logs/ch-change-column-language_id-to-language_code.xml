        </update>
        <update tableName="habit_translation">
            <column name="language_id" value="en" />
            <where>language_id = '2'</where>
        </update>
        <renameColumn tableName="habit_translation" oldColumnName="language_id" newColumnName="language_code" />
    </changeSet>
</databaseChangeLog>