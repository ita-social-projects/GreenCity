<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="createDailyFactTable" author="Oleh Popovych">
        <createTable tableName="daily_fact">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="fact_en" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="fact_uk" type="VARCHAR">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="daily_fact"
                baseColumnNames="user_id"
                constraintName="fk_daily_fact_user"
                referencedTableName="users"
                referencedColumnNames="id"
                deferrable="false"
                initiallyDeferred="false"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>
