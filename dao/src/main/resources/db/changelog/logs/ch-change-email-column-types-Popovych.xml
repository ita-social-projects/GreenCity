                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="increase-email-length-in-user-table-to-72" author="Oleh Popovych">
        <modifyDataType tableName="greencity_users" columnName="email" newDataType="VARCHAR(72)"/>
