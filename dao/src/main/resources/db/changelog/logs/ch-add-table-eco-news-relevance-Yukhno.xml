<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="Yukhno-eco-news-relevance" author="Dmytro Yukhno">
        <createTable tableName="eco_news_relevance">
            <column name="eco_news_id" type="BIGINT">
                <constraints primaryKey="true"
                             nullable="false"
                             foreignKeyName="fk_eco_news_relevance_news"
                             references="eco_news(id)"
                             deleteCascade="true"/>
            </column>
            <column name="title_vector" type="TEXT"/>
        </createTable>
        <rollback>
            <dropTable tableName="eco_news_relevance"/>
        </rollback>
    </changeSet>

    <changeSet id="eco-news-relevance-outdated-column-Zadyraichuk" author="Rostyslav Zadyraichuk">
        <addColumn tableName="eco_news_relevance">
            <column name="outdated" type="BOOLEAN" defaultValue="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="eco_news_relevance" columnName="outdated"/>
        </rollback>
    </changeSet>

</databaseChangeLog>

