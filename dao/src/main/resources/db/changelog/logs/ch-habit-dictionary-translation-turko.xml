<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet author="Volodymyr Turko" id="46513268344-2012222">
        <createTable tableName="habit_translation">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints primaryKey="true"/>
            </column>

            <column name="name" type="VARCHAR(255)">
            </column>

            <column  name="description" type="text">
                <constraints nullable="false"/>
            </column>

            <column name="habit_item" type="VARCHAR(255)">
            </column>

            <column name="language_code" type="varchar(5)">
                <constraints nullable="false"/>
            </column>
            <column name="habit_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
